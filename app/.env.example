# Copier ce fichier en `.env` et renseigner les valeurs.
# `supabase start` (dans backend/supabase) affiche l'API URL et l'anon key en local.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key

# Style de carte MapLibre (JSON de style pointant vers des tuiles OSM).
# Ex. OpenFreeMap : https://openfreemap.org  — style sombre custom recommandé.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Endpoint OSRM (profil piéton) pour le routing marche.
OSRM_BASE_URL=https://router.project-osrm.org
